{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.aic-demo",
  "name": "aic-demo",
  "title": "PocketJS on ArtInChip",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": ["input.touch", "text.glyphs.baked"]
    }
  },
  "app": {
    "entry": "main.tsx",
    "output": "aic-demo",
    "framework": "solid",
    "viewport": {
      "logical": [480, 272],
      "presentation": "native"
    }
  }
}
